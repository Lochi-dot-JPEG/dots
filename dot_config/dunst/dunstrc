[global]
separator_color= frame
font = Noto Sans
origin = top-right
offset = (0, 0)


[urgency_low]
background = "#1f1f28"
foreground = "#dcd7ba"
frame_color = "#7daea3"
timeout = 5

[urgency_normal]
background = "#1f1f28"
foreground = "#dcd7ba"
frame_color = "#1f1f28"
timeout = 5

[urgency_critical]
background = "#3c1f1e"
foreground = "#dcd7ba"
frame_color = "#ea6962"
timeout = 15
